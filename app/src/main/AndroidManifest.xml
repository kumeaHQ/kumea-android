<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Background-sync completion / sustained-failure notifications (Ticket 2.3).
         Runtime-requested on Android 13+; sync runs silently if denied. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
         Shamba location capture (KWAP-03 §5.1). These were MISSING, and that
         absence was the root cause of the `useGps = 1, locationLat = null` rows:
         the create screen offered a "Use my location" button, but an app cannot
         request a permission it has never declared, so the tap could only ever
         set a flag. Declared first, requested at the moment of the tap.

         FINE is what a shamba boundary needs — COARSE alone is a few hundred
         metres, which cannot tell one farm from its neighbour. COARSE is listed
         too because Android 12+ lets the user grant approximate location only,
         and a rough fix that says it is rough beats refusing to work at all.

         Foreground only. There is no background location use here and there must
         not be: capture happens while a human is looking at the screen.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
         GPS is how a shamba is located, but the app is useful without it (the
         farm still saves, location simply stays null), so it must not become an
         install filter on a handset with a weak or absent GPS chip.
    -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".KumeaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kumea">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Kumea">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Disable the default WorkManager initializer so our custom
            Configuration.Provider (KumeaApplication) can initialize it instead.
            Without this, WorkManager is initialized twice on cold start,
            causing an IllegalStateException.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="remove">
        </provider>
    </application>

</manifest>
